# =============================================================================
# AIGuardFabric (智御矩阵) — 环境变量样例
# 用法：复制为 .env 后按需修改。.env 不入库（见 .gitignore）。
# 所有脚本（scripts/*.ps1、Justfile、docker-compose.yml）都从这里注入路径与密钥，
# 严禁在脚本里硬编码绝对路径（铁律 4）。
# =============================================================================

# ---------------------------------------------------------------------------
# 0. 路径纪律（铁律 1/2/4）
# ---------------------------------------------------------------------------
# 项目根：唯一可写区。所有源码/依赖/数据卷/日志/产物都在这里。
AGF_PROJECT_ROOT=.
# 可选：自检时用于比对"文档约定的默认项目根"（铁律 1）。
# 脚本本身不硬编码任何绝对路径；留空则只做结构性判定（根下必须有 Cargo.toml）。
AGF_EXPECTED_ROOT=
# 本机既有只读工具链（复用，不修改，不安装）
AGF_ENV_ROOT=./.environment
# 项目内安装的 CLI（cargo install --root 等）
AGF_TOOLS_DIR=./tools
# 运行期数据卷（bind mount 到容器）
AGF_DATA_DIR=./data
# 离线依赖/二进制
AGF_VENDOR_DIR=./vendor
# 本地模型（可选）
AGF_MODELS_DIR=./models

# ---------------------------------------------------------------------------
# 1. 运行模式
# ---------------------------------------------------------------------------
# 1 = 全部外部依赖走 Mock/回放（离线可演示，阶段一默认）
# 0 = 允许真实外部调用（阶段二，需要凭据）
AGF_MOCK_MODE=1
# 允许使用部署主机 ECS/ACK 身份的租户 UUID，逗号分隔；留空禁止，不支持 *。
AGF_CLOUD_WORKLOAD_TENANTS=
# ACK OIDC 的只读 ServiceAccount token 文件及 RAM OIDC Provider ARN。
# Docker 使用容器内路径，并在 compose 中只读挂载对应 token 文件。
ALIBABA_CLOUD_OIDC_TOKEN_FILE=
ALIBABA_CLOUD_OIDC_PROVIDER_ARN=
# dev | prod
AGF_ENV=dev
# debug | info | warn | error
AGF_LOG_LEVEL=info
# 落盘策略：pretty | json
AGF_LOG_FORMAT=pretty
# 是否在 Mock 模式下允许"未配置适配器"自动降级（生产建议 1，保证平台可启动）
AGF_DEGRADE_ON_MISSING=1

# ---------------------------------------------------------------------------
# 2. 服务监听
# ---------------------------------------------------------------------------
AGF_SERVER_HOST=0.0.0.0
AGF_SERVER_PORT=8080
AGF_WEB_PORT=8081
AGF_INGEST_SQL_SINK=1
AGF_INGEST_HOST=0.0.0.0
# 原生接收器固定归属；独立部署使用不同 INSTANCE_ID，重启后不要更改。
AGF_INGEST_TENANT_ID=00000000-0000-0000-0000-000000000001
AGF_INGEST_INSTANCE_ID=local
# 可选：接收器名称到已有日志源 UUID 的 JSON 映射；留空使用稳定 ID。
AGF_INGEST_SOURCE_IDS={}
AGF_INGEST_PORT=8090
# Syslog 接入（TCP/UDP 514 需要特权，开发用 5514）
AGF_SYSLOG_TCP_PORT=5514
AGF_SYSLOG_UDP_PORT=5514
# Optional Syslog TLS. Mount PEM files read-only in the collector and reference container paths.
AGF_SYSLOG_TLS_PORT=6514
AGF_SYSLOG_TLS_CERT=
AGF_SYSLOG_TLS_KEY=
# Supplying a CA requires a valid client certificate on every TLS connection.
AGF_SYSLOG_TLS_CLIENT_CA=
# MCP HTTP 代理：由 agf-server 监听；0 禁用独立端口，API 同端口仍提供 MCP 路由。
AGF_MCP_PROXY_PORT=8091
# Compose 宿主机映射：默认用 8092 访问 server 的 MCP 代理，避开可能已被占用的 8091。
AGF_MCP_PROXY_HOST_PORT=8092
# 调度服务（apps/scheduler）：本地 cron 与 SchedulerX3 双模
AGF_SCHEDULER_HOST=0.0.0.0
AGF_SCHEDULER_PORT=9101
# local-cron | schedulerx3；云模式需要以下身份、回调及数据库配置
AGF_SCHEDULER_BACKEND=local-cron
# calendar 使用五段 UTC 日历；interval 使用下面的间隔（开发/兼容模式）。
AGF_SCHEDULER_TIMING=calendar
AGF_SCHEDULER_TENANT_ID=
AGF_SCHEDULER_CALLBACK_APP_ID=
AGF_SCHEDULER_CALLBACK_TOKEN=
# 仅本机监听；实际云执行器需通过已配置的内网代理访问。
AGF_SCHEDULER_BIND=127.0.0.1
AGF_SCHEDULER_ASSET_INVENTORY_CRON=0 2 * * *
AGF_SCHEDULER_AGENTTEAMS_SYNC_ENABLED=false
AGF_SCHEDULER_AGENTTEAMS_CONFIRM_LIVE=false
AGF_SCHEDULER_LOG_PULL_CRON=*/10 * * * *
AGF_SCHEDULER_REDTEAM_CRUISE_CRON=0 3 * * MON
AGF_SCHEDULER_RULE_HOT_RELOAD_CRON=*/5 * * * *
AGF_SCHEDULER_REPORT_GENERATE_CRON=0 7 * * *
AGF_SCHEDULER_COLD_ARCHIVE_CRON=0 4 1 * *
# interval 模式的任务间隔（秒）；辅助任务也使用此间隔。
AGF_SCHEDULER_INTERVAL_SECS=3600
# 真实 CMS 指标上报必须填写已创建的云监控应用分组 ID；模拟模式可留空。
AGF_CMS_GROUP_ID=
# 红队巡航模拟目标的防护强度 0-100（越大越难攻破；仅离线模拟用）
# 使用平台用例库和持久战役，服务 Key 需 redteam:read/execute；在控制台查 scheduler-cruise。
AGF_SCHEDULER_REDTEAM_GUARD=35
# 红队巡航报告落盘目录（相对项目根）
AGF_REPORT_DIR=data/reports
# Prometheus 指标
AGF_METRICS_PORT=9100
# 指标/健康检查基路径
AGF_API_PREFIX=/api/v1

# ---------------------------------------------------------------------------
# 3. 数据库（PostgreSQL 16 + TimescaleDB）
# ---------------------------------------------------------------------------
AGF_PG_HOST=127.0.0.1
AGF_PG_PORT=5432
AGF_PG_DB=aiguardfabric
AGF_PG_USER=agf
# 由 scripts/dev-up.ps1 / seed.ps1 首次生成随机值；禁止使用弱口令（安全基线 §2.6）
AGF_PG_PASSWORD=
# SQLx 连接串（供 agfctl migrate / sqlx-cli 使用）
DATABASE_URL=postgres://agf:REPLACE_WITH_PASSWORD@127.0.0.1:5432/aiguardfabric
# 连接池
AGF_PG_POOL_MAX=20
AGF_PG_POOL_MIN=2

# ---------------------------------------------------------------------------
# 4. Redis
# ---------------------------------------------------------------------------
AGF_REDIS_URL=redis://127.0.0.1:6379/0

# ---------------------------------------------------------------------------
# 5. NATS JetStream（默认内置事件总线；置 0 则用进程内广播）
# ---------------------------------------------------------------------------
AGF_NATS_ENABLED=1
AGF_NATS_URL=nats://127.0.0.1:4222
AGF_NATS_STREAM=AGF_EVENTS

# ---------------------------------------------------------------------------
# 6. ClickHouse（可选冷热分层，profile=clickhouse 时启动）
# ---------------------------------------------------------------------------
AGF_CLICKHOUSE_ENABLED=0
AGF_CLICKHOUSE_URL=http://127.0.0.1:8123
AGF_CLICKHOUSE_DB=agf
AGF_CLICKHOUSE_USER=default
AGF_CLICKHOUSE_PASSWORD=

# ---------------------------------------------------------------------------
# 7. 对象存储（MinIO / S3 兼容；证据包、原始日志归档）
# ---------------------------------------------------------------------------
AGF_S3_ENDPOINT=http://127.0.0.1:9000
AGF_S3_REGION=us-east-1
AGF_S3_BUCKET=agf-evidence
AGF_S3_ACCESS_KEY=
AGF_S3_SECRET_KEY=
AGF_S3_FORCE_PATH_STYLE=1

# ---------------------------------------------------------------------------
# 8. 安全：JWT / 主密钥 / 引导管理员
# ---------------------------------------------------------------------------
# JWT 签名密钥（>=32 字节）。scripts/selfcheck.ps1 会检查长度。
AGF_JWT_SECRET=
AGF_JWT_ACCESS_TTL_SECS=3600
AGF_JWT_REFRESH_TTL_SECS=259200
AGF_JWT_ISSUER=aiguardfabric
# 数据加密主密钥（AES-256-GCM，base64 编码 32 字节）。首次部署用 agfctl genkey 生成。
AGF_MASTER_KEY_BASE64=
# 可选 KMS 后端：none | local-file | aliyun-kms
AGF_KMS_BACKEND=local-file
AGF_KMS_KEY_ID=
# 引导管理员（首登强制改密）
AGF_BOOTSTRAP_ADMIN_USER=admin
AGF_BOOTSTRAP_ADMIN_EMAIL=admin@aiguardfabric.local
# 留空 = 首启随机生成并写入 data/seed/bootstrap-admin.txt（0600），并打日志提示
AGF_BOOTSTRAP_ADMIN_PASSWORD=
# 强制首登改密（安全基线，默认开启，不建议关闭）
AGF_FORCE_PASSWORD_CHANGE=1
# 密码策略
AGF_PASSWORD_MIN_LENGTH=12
AGF_PASSWORD_REQUIRE_CLASSES=1
# 登录失败锁定
AGF_LOGIN_MAX_FAILURES=5
AGF_LOGIN_LOCKOUT_SECS=900

# ---------------------------------------------------------------------------
# 9. 多租户与配额
# ---------------------------------------------------------------------------
AGF_DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001
AGF_DEFAULT_TENANT_SLUG=default
AGF_TENANT_PHYSICAL_ISOLATION=0
# 三级配额默认值（租户 / Agent / 会话）
AGF_QUOTA_TENANT_TOKENS_PER_DAY=5000000
AGF_QUOTA_AGENT_TOKENS_PER_DAY=500000
AGF_QUOTA_SESSION_TOKENS=100000
AGF_QUOTA_TENANT_REQ_PER_MIN=6000

# ---------------------------------------------------------------------------
# 10. 历史厂商变量示例（当前服务不读取本节变量，不要在这里填真实密钥）
# 实际接入请在“模型网关 → 模型接入配置”选择厂商、填模型 ID 与 Base URL、
# 输入厂商凭据；凭据由平台加密保存。模拟模式使用 AGF_MOCK_MODE=1。
# 真实厂商联调属于阶段二，登记见 docs/pending-verification.md。
# ---------------------------------------------------------------------------
AGF_LLM_DEFAULT_PROVIDER=mock
AGF_LLM_DEFAULT_MODEL=mock-analyst-1
AGF_LLM_ROUTING_STRATEGY=cost-first
AGF_LLM_REQUEST_TIMEOUT_SECS=60
AGF_LLM_MAX_RETRIES=2
AGF_LLM_SEMANTIC_CACHE=1
# 内容安全前置过滤
AGF_LLM_PRESCREEN=1

AGF_OPENAI_BASE_URL=https://api.openai.com/v1
AGF_OPENAI_API_KEY=
AGF_OPENAI_ORG=

AGF_ANTHROPIC_BASE_URL=https://api.anthropic.com
AGF_ANTHROPIC_API_KEY=
AGF_ANTHROPIC_VERSION=2023-06-01

AGF_GEMINI_BASE_URL=https://generativelanguage.googleapis.com
AGF_GEMINI_API_KEY=

AGF_AZURE_OPENAI_ENDPOINT=
AGF_AZURE_OPENAI_API_KEY=
AGF_AZURE_OPENAI_API_VERSION=2024-10-21
AGF_AZURE_OPENAI_DEPLOYMENT=

AGF_BEDROCK_REGION=us-east-1
AGF_BEDROCK_ACCESS_KEY_ID=
AGF_BEDROCK_SECRET_ACCESS_KEY=

# 阿里云百炼 / 通义
AGF_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AGF_DASHSCOPE_API_KEY=

# 火山方舟 / 豆包
AGF_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
AGF_ARK_API_KEY=

# 腾讯混元
AGF_HUNYUAN_BASE_URL=https://api.hunyuan.cloud.tencent.com/v1
AGF_HUNYUAN_API_KEY=

# 百度文心
AGF_QIANFAN_BASE_URL=https://qianfan.baidubce.com/v2
AGF_QIANFAN_API_KEY=

# Kimi (Moonshot)
AGF_MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
AGF_MOONSHOT_API_KEY=

# DeepSeek
AGF_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
AGF_DEEPSEEK_API_KEY=

# 智谱 GLM
AGF_ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
AGF_ZHIPU_API_KEY=

# MiniMax
AGF_MINIMAX_BASE_URL=https://api.minimax.chat/v1
AGF_MINIMAX_API_KEY=

# 本地推理 Ollama / vLLM（数据不出域）
AGF_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
AGF_VLLM_BASE_URL=http://127.0.0.1:8000/v1

# ---------------------------------------------------------------------------
# 11. 阿里云 AgentTeams 与五底座服务（全部可选，无凭据走 MockAdapter）
# 凭据优先 RAM Role / STS；禁止长期 AK 明文落盘（用 agfctl secret set 写库）
# ---------------------------------------------------------------------------
AGF_ALIYUN_ENABLED=0
AGF_ALIYUN_REGION_ID=cn-hangzhou
AGF_ALIYUN_ACCESS_KEY_ID=
AGF_ALIYUN_ACCESS_KEY_SECRET=
# STS 临时凭据（优先）
AGF_ALIYUN_STS_TOKEN=
AGF_ALIYUN_STS_EXPIRE=
# 跨账号 AssumeRole
AGF_ALIYUN_ASSUME_ROLE_ARN=
AGF_ALIYUN_ROLE_SESSION_NAME=agf-cross-account
# 各服务 endpoint（留空用 SDK 默认；Privatelink 场景填私网 endpoint）
AGF_ALIYUN_ENDPOINT_CMS=
AGF_ALIYUN_ENDPOINT_APIG=
AGF_ALIYUN_ENDPOINT_MSE=
AGF_ALIYUN_ENDPOINT_PRIVATELINK=
AGF_ALIYUN_ENDPOINT_SCHEDULERX3=
AGF_ALIYUN_ENDPOINT_AGENTTEAMS=
# SchedulerX3 命名空间与分组
AGF_ALIYUN_SCHEDULERX3_NAMESPACE=
AGF_ALIYUN_SCHEDULERX3_GROUP=agf
# APIG 实例与网关
AGF_ALIYUN_APIG_INSTANCE_ID=
AGF_ALIYUN_APIG_GATEWAY_ID=
# MSE 命名空间
AGF_ALIYUN_MSE_NAMESPACE=
# Privatelink 终端节点
AGF_ALIYUN_PRIVATELINK_ENDPOINT_ID=
# AgentTeams
AGF_ALIYUN_AGENTTEAMS_TEAM_ID=

# ---------------------------------------------------------------------------
# 12. 外部告警设备接入（全部可选；MCP 优先 + 多协议兜底）
# ---------------------------------------------------------------------------
AGF_QINGTENG_ENABLED=0
AGF_QINGTENG_MCP_URL=
AGF_QINGTENG_API_URL=
AGF_QINGTENG_API_TOKEN=

AGF_ALIYUN_WAF_ENABLED=0
AGF_HUAWEI_WAF_ENABLED=0
AGF_HUAWEI_HSS_ENABLED=0
AGF_TENCENT_ENABLED=0
AGF_SANGFOR_ENABLED=0
AGF_QIANXIN_ENABLED=0
AGF_NSFOCUS_ENABLED=0
AGF_TOPSEC_ENABLED=0
AGF_FORTINET_ENABLED=0
AGF_PALOALTO_ENABLED=0
AGF_CROWDSTRIKE_ENABLED=0
AGF_WAZUH_ENABLED=0

# ---------------------------------------------------------------------------
# 13. 南向采集网关（不可开放 MCP 的设备）
# ---------------------------------------------------------------------------
AGF_COLLECTOR_ENABLED=0
AGF_COLLECTOR_MTLS_CA=
AGF_COLLECTOR_CERT=
AGF_COLLECTOR_KEY=
AGF_COLLECTOR_UPLINK=https://127.0.0.1:8090/api/v1/ingest/agent
AGF_COLLECTOR_INTERVAL_SECS=30

# --- 采集器上行端点 /api/v1/ingest/agent 的 mTLS 身份（agf-server 侧）---------
# agf-server 自身**不终结 TLS**：客户端证书由入口网关校验后经请求头透传
# （nginx: proxy_set_header X-SSL-Client-Verify $ssl_client_verify;
#         proxy_set_header X-SSL-Client-Cert   $ssl_client_escaped_cert;）。
# 因此下面这些开关只有在"应用只接受来自网关的流量"时才能打开。
AGF_AGENT_MTLS_TRUST_PROXY=0
# 证书主体 → 角色 的映射（**分号**分隔多条；无映射即 403，不会"有证书就全权"）
AGF_AGENT_MTLS_MAP=
AGF_AGENT_MTLS_DEFAULT_ROLE=
AGF_AGENT_MTLS_DEFAULT_TENANT=
# 1 = 只接受证书身份（Bearer/API Key 一律 401）
AGF_AGENT_MTLS_REQUIRED=0

# --- 采集器客户端（agf-agent 二进制）的 mTLS 上行 ---------------------------
# cert/key 必须成对；缺一即报错（不静默降级为单向 TLS）
AGF_AGENT_TLS_CERT=
AGF_AGENT_TLS_KEY=
AGF_AGENT_TLS_CA=
# 跳过服务端证书链校验：仅当 AGF_ENV=dev 或 AGF_AGENT_TLS_ALLOW_INSECURE=1 时生效，且必然 warn
AGF_AGENT_TLS_INSECURE_SKIP_VERIFY=0
AGF_AGENT_TLS_ALLOW_INSECURE=0

# ---------------------------------------------------------------------------
# 14. 通知渠道（告警升级路由）
# ---------------------------------------------------------------------------
AGF_NOTIFY_DINGTALK_WEBHOOK=
AGF_NOTIFY_FEISHU_WEBHOOK=
AGF_NOTIFY_WECOM_WEBHOOK=
# --- 邮件告警（email 适配器 = 真实 SMTP 发送）------------------------------
# 企业自行填写上面 5 个（HOST/PORT/USER/PASSWORD/FROM）即可启用邮件告警。
AGF_NOTIFY_SMTP_HOST=
AGF_NOTIFY_SMTP_PORT=587
AGF_NOTIFY_SMTP_USER=
AGF_NOTIFY_SMTP_PASSWORD=
AGF_NOTIFY_SMTP_FROM=
# ⚠️ 下面 4 个变量名**已登记**（与 email 适配器的设置键一一对应），但
# **当前没有任何代码读取它们**——适配器从 `AdapterConfig.settings` 取参。
# 接线（把 env 灌进 AdapterConfig.settings）属下一轮工作，见
# `TODO(adapter-email-env-wiring)`：现在填了也不会生效，别当成"已打通"。
AGF_NOTIFY_SMTP_TO=
# starttls | tls | none（默认 starttls = 强制 STARTTLS 升级；none 是明文，仅限受信内网中继）
AGF_NOTIFY_SMTP_SECURITY=starttls
AGF_NOTIFY_SMTP_SUBJECT_PREFIX=[AIGuardFabric]
# 凭据兜底口（`EnvSecrets` 按 `AGF_ADAPTER_<适配器名>_<凭据键>` 规则组装）；
# 同样尚未接线，见上面的 TODO 锚点。
AGF_ADAPTER_EMAIL_SMTP_PASSWORD=
AGF_NOTIFY_PAGERDUTY_KEY=
AGF_NOTIFY_GENERIC_WEBHOOK=

# ---------------------------------------------------------------------------
# 15. 可观测性
# ---------------------------------------------------------------------------
AGF_OTEL_ENABLED=0
AGF_OTEL_ENDPOINT=http://127.0.0.1:4318
AGF_OTEL_SERVICE_NAME=agf-server
AGF_PROMETHEUS_ENABLED=1
AGF_GRAFANA_ENABLED=0
AGF_GRAFANA_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# 16. 前端（Vite）
# ---------------------------------------------------------------------------
# 控制台走同源（nginx 反代 /api/ 与 /ws）；留空即可，不要指向 :8080 以免绕过 nginx 代理
VITE_API_BASE_URL=
VITE_WS_BASE_URL=ws://127.0.0.1:8080
VITE_DEFAULT_LOCALE=zh-CN
VITE_APP_TITLE="AIGuardFabric 智御矩阵"

# ---------------------------------------------------------------------------
# 17. 测试与门禁
# ---------------------------------------------------------------------------
AGF_COVERAGE_MIN=70
# 覆盖率所需 LLVM 工具（llvm-cov / llvm-profdata）所在目录。
# 留空时 scripts/coverage.ps1 依次尝试：LLVM_COV/LLVM_PROFDATA 环境变量 →
# rustup sysroot 的 llvm-tools-preview → 本机既有只读 LLVM（Android SDK NDK 自带 LLVM、
# %ProgramFiles%\LLVM\bin）。本机 rustc 未装 llvm-tools-preview，实测复用 NDK 的 LLVM 21
# 可正常 merge rustc 1.97.1(LLVM 22.1) 产生的 .profraw。
AGF_LLVM_BIN=
AGF_FIXTURE_LIVE_FETCH=0
AGF_REPLAY_DIR=./tests/replay
AGF_REDTEAM_CASE_DIR=./redteam
AGF_RULES_DIR=./rules
# 红队用例库与解析模板库目录（server / ingest / scheduler 三个进程共用同一套解析规则）。
# 容器内默认 /app/redteam 与 /app/parsers；本机留空则回退 <项目根>/redteam 与 <项目根>/parsers。
# `AGF_REDTEAM_CASE_DIR` 是 `AGF_REDTEAM_DIR` 的兼容别名，二者取其一即可。
AGF_REDTEAM_DIR=
AGF_PARSERS_DIR=

# ---- 仅供 compose 使用的镜像版本 ----
AGF_IMAGE_TAG=0.1.0
POSTGRES_IMAGE=timescale/timescaledb:latest-pg16
REDIS_IMAGE=redis:7.4-alpine
NATS_IMAGE=nats:2.10-alpine
CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:24.8-alpine
MINIO_IMAGE=quay.io/minio/minio:latest
GRAFANA_IMAGE=grafana/grafana:11.4.0
