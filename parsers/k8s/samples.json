{
  "version": 1,
  "note": "Kubernetes/Docker 模板正样本与关键字段断言。JSON 样本按 audit.k8s.io/v1 Event、core/v1 Event 与 docker json-file 日志的公开结构重建；未联网抓取。",
  "samples": {
    "k8s-audit-json": {
      "protocol": "file",
      "line": "{\"kind\":\"Event\",\"apiVersion\":\"audit.k8s.io/v1\",\"level\":\"RequestResponse\",\"auditID\":\"9f2c1d4b-6a8e-0f3c-5d7b-9a1e2f4c6d8b\",\"stage\":\"ResponseComplete\",\"requestURI\":\"/api/v1/namespaces/default/secrets/app-secret\",\"verb\":\"get\",\"user\":{\"username\":\"system:serviceaccount:default:ci-runner\",\"uid\":\"a1b2c3d4-0000-0000-0000-000000000000\",\"groups\":[\"system:serviceaccounts\",\"system:authenticated\"]},\"sourceIPs\":[\"10.20.30.220\"],\"userAgent\":\"kubectl/v1.29.0 (linux/amd64) kubernetes/1a2b3c4\",\"objectRef\":{\"resource\":\"secrets\",\"namespace\":\"default\",\"name\":\"app-secret\",\"apiVersion\":\"v1\"},\"responseStatus\":{\"metadata\":{},\"code\":200},\"requestReceivedTimestamp\":\"2026-02-21T11:05:00.123456Z\",\"stageTimestamp\":\"2026-02-21T11:05:00.234567Z\",\"annotations\":{\"authorization.k8s.io/decision\":\"allow\",\"authorization.k8s.io/reason\":\"RBAC: allowed by ClusterRole\"}}",
      "expect": {
