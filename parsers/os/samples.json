{
  "version": 1,
  "note": "主机/终端类模板正样本与关键字段断言。auditd 记录、sshd/sudo syslog、Windows 事件 XML 与 JSON 转发样本均按公开格式重建；未联网抓取，IP 用 RFC 5737 段。",
  "samples": {
    "linux-auditd-syscall-regex": {
      "protocol": "syslog",
      "line": "<134>Feb 21 11:09:00 app-prod-01 auditd[1234]: type=SYSCALL msg=audit(1771666200.125:4567): arch=c000003e syscall=59 success=yes exit=0 a0=7ffd a1=7ffc a2=7ffe a3=0 items=2 ppid=1234 pid=4567 auid=1000 uid=0 gid=0 euid=0 suid=0 fsuid=0 egid=0 sgid=0 fsgid=0 tty=pts0 ses=12 comm=\"curl\" exe=\"/usr/bin/curl\" subj=unconfined key=\"download_exec\"",
      "expect": {
        "host.name": "app-prod-01",
        "event.time": "2026-02-21T09:30:00.125Z",
        "event.sequence": "4567",
        "process.syscall": "59",
        "event.outcome": "yes",
        "process.exit_code": "0",
        "process.parent.pid": "1234",
        "process.pid": "4567",
        "user.audit_id": "1000",
        "user.id": "0",
        "process.name": "curl",
        "process.executable": "/usr/bin/curl",
        "rule.name": "download_exec",
        "event.category": "process",
        "event.severity": "medium"
      }
    },
    "linux-auditd-user-kv": {
      "protocol": "syslog",
      "line": "<134>Feb 21 11:10:30 app-prod-01 auditd[1234]: type=USER_LOGIN msg=audit(1771666230.789:4568): pid=4571 uid=0 auid=1000 ses=12 subj=unconfined op=login acct=\"alice\" exe=\"/usr/sbin/sshd\" hostname=? addr=203.0.113.211 terminal=ssh res=success",
      "expect": {
        "host.name": "app-prod-01",
        "event.category_raw": "USER_LOGIN",
        "process.pid": "4571",
        "user.id": "0",
        "user.audit_id": "1000",
        "user.session_id": "12",
        "event.action_raw": "login",
        "user.name": "alice",
        "process.executable": "/usr/sbin/sshd",
        "source.ip": "203.0.113.211",
        "process.tty": "ssh",
        "event.outcome": "success",
        "event.category": "authentication",
        "event.severity": "info"
      }
    },
    "linux-sshd-auth-grok": {
      "protocol": "syslog",
      "fixture": "parsers/linux-sshd-auth-1.log",
      "line": "<34>Feb 21 11:11:00 web-prod-01 sshd[2311]: Failed password for invalid user admin from 203.0.113.212 port 51234 ssh2",
      "expect": {
        "host.name": "web-prod-01",
        "process.name": "sshd",
        "process.pid": "2311",
        "user.name": "admin",
        "source.ip": "203.0.113.212",
        "source.port": "51234",
        "event.outcome": "Failed",
        "event.category": "authentication",
        "event.action": "login",
        "event.severity": "medium"
      }
    },
    "linux-sudo-syslog-grok": {
      "protocol": "syslog",
      "line": "<86>Feb 21 11:12:00 app-prod-01 sudo: alice : TTY=pts/0 ; PWD=/home/alice ; USER=root ; COMMAND=/usr/bin/apt-get install nginx",
      "expect": {
        "host.name": "app-prod-01",
        "process.name": "sudo",
        "user.name": "alice",
        "process.tty": "pts/0",
        "process.working_directory": "/home/alice",
        "destination.user.name": "root",
        "process.command_line": "/usr/bin/apt-get install nginx",
        "event.category": "process",
        "event.action": "elevate",
        "event.severity": "low"
      }
    },
    "windows-eventlog-json": {
      "protocol": "file",
      "line": "{\"@timestamp\":\"2026-02-21T11:13:00.123Z\",\"winlog\":{\"channel\":\"Security\",\"provider_name\":\"Microsoft-Windows-Security-Auditing\",\"event_id\":4625,\"record_id\":1234567,\"computer_name\":\"DC-01\",\"event_data\":{\"TargetUserName\":\"administrator\",\"IpAddress\":\"203.0.113.213\",\"LogonType\":\"3\",\"Status\":\"0xC000006D\"}},\"event\":{\"code\":\"4625\",\"outcome\":\"failure\",\"category\":[\"authentication\"]},\"host\":{\"name\":\"DC-01\"}}",
      "expect": {
        "event.time": "2026-02-21T11:13:00.123Z",
        "log.channel": "Security",
        "event.provider": "Microsoft-Windows-Security-Auditing",
        "event.code": "4625",
        "event.sequence": "1234567",
        "host.name": "DC-01",
        "user.name": "administrator",
        "source.ip": "203.0.113.213",
        "log.logon.type": "3",
        "error.code": "0xC000006D",
        "event.outcome": "failure",
        "event.category": "authentication",
        "event.severity": "medium"
      }
    },
    "windows-eventlog-xml": {
      "protocol": "syslog",
      "line": "<Event xmlns=\"http://schemas.microsoft.com/win/2004/08/events/event\"><System><Provider Name=\"Microsoft-Windows-Security-Auditing\"/><EventID>4625</EventID><TimeCreated SystemTime=\"2026-02-21T11:14:00.1234567Z\"/><Computer>DC-01</Computer><Channel>Security</Channel><EventRecordID>1234568</EventRecordID></System><EventData><Data Name=\"TargetUserName\">administrator</Data><Data Name=\"IpAddress\">203.0.113.214</Data><Data Name=\"LogonType\">3</Data></EventData></Event>",
      "expect": {
        "event.code": "4625",
        "event.time": "2026-02-21T11:14:00.123Z",
        "host.name": "DC-01",
        "log.channel": "Security",
        "event.sequence": "1234568",
        "user.name": "administrator",
        "source.ip": "203.0.113.214",
        "event.category": "authentication",
        "event.severity": "medium"
      }
    },
    "windows-sysmon-json": {
      "protocol": "file",
      "line": "{\"@timestamp\":\"2026-02-21T11:15:00.123Z\",\"winlog\":{\"channel\":\"Microsoft-Windows-Sysmon/Operational\",\"event_id\":1,\"computer_name\":\"WIN-APP-03\",\"event_data\":{\"UtcTime\":\"2026-02-21 11:15:00.123\",\"Image\":\"C:\\\\Windows\\\\System32\\\\cmd.exe\",\"CommandLine\":\"cmd.exe /c whoami\",\"ParentImage\":\"C:\\\\Windows\\\\explorer.exe\",\"User\":\"EXAMPLE\\\\admin\",\"Hashes\":\"MD5=9F2C1D4B6A8E0F3C5D7B9A1E2F4C6D8B,SHA256=9F2C1D4B6A8E0F3C5D7B9A1E2F4C6D8B0A2E4F6C\"}},\"host\":{\"name\":\"WIN-APP-03\"}}",
      "expect": {
        "event.time": "2026-02-21T11:15:00.123Z",
        "log.channel": "Microsoft-Windows-Sysmon/Operational",
        "event.code": "1",
        "host.name": "WIN-APP-03",
        "process.start": "2026-02-21 11:15:00.123",
        "process.executable": "C:\\Windows\\System32\\cmd.exe",
        "process.command_line": "cmd.exe /c whoami",
        "process.parent.executable": "C:\\Windows\\explorer.exe",
        "user.name": "EXAMPLE\\admin",
        "process.hashes": "MD5=9F2C1D4B6A8E0F3C5D7B9A1E2F4C6D8B,SHA256=9F2C1D4B6A8E0F3C5D7B9A1E2F4C6D8B0A2E4F6C",
        "event.category": "process",
        "event.severity": "info"
      }
    }
  }
}
