    {
      "datasource": { "type": "prometheus", "uid": "agf-prometheus" },
      "description": "当前全平台归一化事件吞吐（EPS）。与 1 小时前基线对比骤降会触发 AgfEpsDrop 告警。",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 1,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "green", "value": 100 }
            ]
          },
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 5, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "pluginVersion": "11.4.0",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "agf-prometheus" },
          "editorMode": "code",
          "expr": "sum(rate(agf_ingest_events_total{tenant_id=~\"$tenant\",vendor=~\"$vendor\"}[$__rate_interval]))",
          "legendFormat": "EPS",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "接入 EPS",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "agf-prometheus" },
      "description": "解析成功率 = success /（success + failure）。低于 99% 需排查模板与厂商日志格式变更。",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 2,
          "mappings": [],
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 95 },
              { "color": "green", "value": 99 }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 5, "x": 5, "y": 1 },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "pluginVersion": "11.4.0",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "agf-prometheus" },
          "editorMode": "code",
          "expr": "100 * sum(rate(agf_ingest_parse_total{result=\"success\",tenant_id=~\"$tenant\",vendor=~\"$vendor\"}[$__rate_interval])) / clamp_min(sum(rate(agf_ingest_parse_total{tenant_id=~\"$tenant\",vendor=~\"$vendor\"}[$__rate_interval])), 1)",
          "legendFormat": "解析成功率",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "解析成功率",
      "type": "stat"
    },
