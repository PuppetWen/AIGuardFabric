# Dev-server proxy target for /api and /ws.
# Defaults to http://127.0.0.1:8080 when unset.
VITE_API_BASE_URL=http://127.0.0.1:8080

# Force the offline demo dataset even when a backend answers (useful for UI work).
# VITE_FORCE_DEMO=true

# Per-request timeout before the console falls back to demo data (ms).
# VITE_API_TIMEOUT_MS=4000
